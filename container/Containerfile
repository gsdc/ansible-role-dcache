# dCache image for the role's container mode (dcache_install_mode: container).
#
# One container runs one dCache domain: the entrypoint (dcache-domain) uses the
# dCache systemd generator from the RPM to build that domain's unit from the
# layout and execs its ExecStart as the dcache user. So the JVM command line is
# exactly that of an RPM install, without running systemd in the container.
#
# The official dcache/dcache images are tarball installs without the generator,
# so this image is built from the RPM.
#
# Build args:
#   DCACHE_VERSION  dCache version, e.g. 11.2.11 (required)
#   JAVA_PACKAGE    dCache 9.2: java-17-openjdk-headless, 10.x/11.x: java-21-openjdk-headless
#   DCACHE_UID/GID  dcache account; default 994:1000 like the official dcache/dcache images.
#                   Host files mounted into the containers must be owned by these IDs.
ARG BASE_IMAGE=quay.io/almalinuxorg/almalinux:9.8
FROM ${BASE_IMAGE}

ARG DCACHE_VERSION
ARG JAVA_PACKAGE=java-21-openjdk-headless
ARG DCACHE_UID=994
ARG DCACHE_GID=1000

LABEL org.opencontainers.image.source="https://github.com/gsdc/ansible-role-dcache" \
      org.opencontainers.image.description="dCache ${DCACHE_VERSION} (RPM), one domain per container via dcache-generator" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${DCACHE_VERSION}"

# Create the account before the RPM so that its postinstall keeps these IDs.
RUN test -n "${DCACHE_VERSION}" \
 && groupadd -g "${DCACHE_GID}" dcache \
 && useradd -r -u "${DCACHE_UID}" -g "${DCACHE_GID}" -d /var/lib/dcache -M -s /bin/bash dcache

# util-linux: setpriv (drop to the dcache user)
RUN dnf -y install "${JAVA_PACKAGE}" procps-ng hostname which iproute util-linux \
 && dnf clean all

# dCache 9.2 RPMs require java-11-headless (10.x/11.x accept java-17/jre-21). The Java
# above is chosen explicitly, and systemd is not used, so install without dependencies.
RUN series="${DCACHE_VERSION%.*}" \
 && curl -fsSL -o /tmp/dcache.rpm "https://dcache.org/old/downloads/1.9/repo/${series}/dcache-${DCACHE_VERSION}-1.noarch.rpm" \
 && rpm -ivh --nodeps /tmp/dcache.rpm \
 && rm -f /tmp/dcache.rpm \
 && test "$(id -u dcache):$(id -g dcache)" = "${DCACHE_UID}:${DCACHE_GID}" \
 && test -x /lib/systemd/system-generators/dcache-generator

COPY dcache-domain /usr/local/bin/dcache-domain
ENTRYPOINT ["/usr/local/bin/dcache-domain"]
