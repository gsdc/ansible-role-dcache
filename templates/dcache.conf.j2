## Common Part

dcache.zookeeper.connection = {{ dcache_headnode }}:2181
dcache.broker.scheme = satellite
dcache.systemd.strict=false
dcache.java.memory.heap = {{ dcache_java_heap }}
dcache.net.wan.port.min = {{ dcache_net_wan_port_min }}
dcache.net.wan.port.max = {{ dcache_net_wan_port_max }}
dcache.net.lan.port.min = {{ dcache_net_lan_port_min }}
dcache.net.lan.port.max = {{ dcache_net_lan_port_max }}
# Pool XRootD movers use the WAN range (dCache default is the LAN range):
# clients redirected by the XRootD door connect to the pool directly.
# For an internal-only XRootD setup, override pool.mover.xrootd.port.min/max
# with the LAN range in the corresponding cell section of the layout.
pool.mover.xrootd.port.min = ${dcache.net.wan.port.min}
pool.mover.xrootd.port.max = ${dcache.net.wan.port.max}
{% if dcache_gplazma_gridmap_file %}
gplazma.gridmap.file={{ dcache_gplazma_gridmap_file }}
{% endif %}
{% if dcache_use_oidc %}

{% for p in dcache_oidc_providers %}
gplazma.oidc.provider!{{ p.name }} = {{ p.issuer }}{{ (' ' ~ p.options) if p.options | default('') }}
{% endfor %}
{% if dcache_oidc_audience_targets %}
gplazma.oidc.audience-targets = {% for a in dcache_oidc_audience_targets %}{{ ('"' ~ a ~ '"') if ' ' in a else a }}{{ " " if not loop.last }}{% endfor %}

{% endif %}
{% endif %}

{% if dcache_layout_type == "standalone" %}
{% if dcache_star_gid_mapping %}
## Required for tape (STAR) integration
star.gid-mapping = {% for gid, path in dcache_star_gid_mapping.items() %}{{ gid }}={{ path }}{{ ", " if not loop.last }}{% endfor %}

{% endif %}
xrootd.limits.threads = 50000
{% if dcache_kerberos_realm %}
dcache.authn.kerberos.realm={{ dcache_kerberos_realm }}
{% endif %}
dcache.authn.hostcert.verify=true
#dcache.paths.billing=/var/log/dcache/billing
dcache.default-retention-policy=REPLICA
dcache.default-access-latency=ONLINE
{% endif %}

{% if dcache_layout_type == "frontend" %}
{% if dcache_srr_storage_descriptor_path %}
storage-descriptor.output.path = {{ dcache_srr_storage_descriptor_path }}
{% endif %}
{% endif %}

dcache.layout={{ dcache_layout_type }}

