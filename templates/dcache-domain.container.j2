# Generated by the gsdc.dcache role from {{ dcache_quadlet_layout_path }}.
# Do not edit: change the layout and rerun the role with --tags dcache_quadlet.
[Unit]
Description=dCache {{ domain }} domain (container)
X-Generated-By=gsdc.dcache
{% if dcache_quadlet_pod %}
After={{ dcache_quadlet_pod }}.pod
Requires={{ dcache_quadlet_pod }}.pod
{% endif %}

[Container]
ContainerName={{ dcache_quadlet_name_prefix }}{{ domain }}
Image={{ dcache_container_image }}
{% if dcache_quadlet_pod %}
Pod={{ dcache_quadlet_pod }}.pod
{% else %}
Network={{ dcache_quadlet_network }}
{% endif %}
# Entrypoint dcache-domain: dcache-generator builds this domain's unit from the
# layout and its ExecStart runs as the dcache user (java is the main process).
Exec={{ domain }}
# catatonit: reaps zombies, forwards signals (SIGQUIT thread dumps) to java
RunInit=true
# From the generated unit (LimitNOFILE)
Ulimit=nofile={{ dcache_quadlet_nofile }}:{{ dcache_quadlet_nofile }}
{% if dcache_quadlet_podman_args %}
PodmanArgs={{ dcache_quadlet_podman_args | join(' ') }}
{% endif %}
{% for v in dcache_quadlet_volumes %}
Volume={{ v }}
{% endfor %}
{% for v in dcache_quadlet_domain_volumes.get(domain, []) %}
Volume={{ v }}
{% endfor %}

[Service]
# Same as the generated unit: Restart=always, RestartSec=dcache.restart.delay,
# java exits with 143 on SIGTERM.
Restart=always
RestartSec={{ dcache_quadlet_restart_sec }}
SuccessExitStatus=143
TimeoutStartSec=300
{% if dcache_quadlet_install %}

[Install]
WantedBy=multi-user.target
{% endif %}
